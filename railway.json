{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && npm install",
    "nixpacks": {
      "path": "./nixpacks.toml"
    }
  },
  "deploy": {
    "startCommand": "cd backend && node server.js",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
